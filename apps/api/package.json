{
  "name": "@hkfinhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/server.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --external:@node-rs/argon2 --external:@prisma/client --external:class-validator --external:class-transformer --external:@nestjs/microservices --external:@nestjs/websockets --external:cache-manager --external:@nestjs/cache-manager --log-level=error"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hkfinhub/accounts": "workspace:*",
    "@hkfinhub/admin": "workspace:*",
    "@hkfinhub/authentication": "workspace:*",
    "@hkfinhub/compliance": "workspace:*",
    "@hkfinhub/database": "workspace:*",
    "@hkfinhub/fx": "workspace:*",
    "@hkfinhub/integration-adyen": "workspace:*",
    "@hkfinhub/integration-partner-stubs": "workspace:*",
    "@hkfinhub/integration-razorpay": "workspace:*",
    "@hkfinhub/integration-razorpayx": "workspace:*",
    "@hkfinhub/integration-stripe": "workspace:*",
    "@hkfinhub/investment": "workspace:*",
    "@hkfinhub/kyc": "workspace:*",
    "@hkfinhub/ledger": "workspace:*",
    "@hkfinhub/notifications": "workspace:*",
    "@hkfinhub/object-storage": "workspace:*",
    "@hkfinhub/payments": "workspace:*",
    "@hkfinhub/shared": "workspace:*",
    "@hkfinhub/transfers": "workspace:*",
    "@hkfinhub/wallet": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.9.0",
    "bullmq": "6.5.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "otplib": "13.5.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
