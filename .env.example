# HK FinHub environment template.
# Copy to .env for local development. NEVER commit real values.
# Every secret below is a placeholder. Real credentials come from the secrets manager
# (AWS Secrets Manager in deployed environments) or your local .env file.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
APP_ENV=local                       # local | sandbox | staging | production
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3100

# ---- Database and cache -----------------------------------------------------
# Used by infrastructure/docker/docker-compose.dev.yml (local only).
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://hkfinhub:CHANGE_ME@localhost:5432/hkfinhub?schema=public
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# ---- Authentication ---------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_MIN_64_CHARS      # openssl rand -base64 64
DIGEST_KEY=CHANGE_ME_BASE64_32_BYTES         # keyed digests for OTPs, refresh tokens, recovery codes
CORS_ORIGINS=http://localhost:3000           # comma-separated allow-list
TRUST_PROXY_HOPS=0
OPENAPI_ENABLED=true
EMAIL_PROVIDER=none                          # none | capture (capture is refused in production)
SMS_PROVIDER=none
TOTP_ISSUER=HK FinHub

# ---- Encryption and secrets -------------------------------------------------
# KMS key ARN or local key reference used for envelope encryption of PII and KYC documents.
# Production uses AWS KMS (not yet built). The local master key below is refused in production.
KMS_KEY_ID=CHANGE_ME
KYC_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES     # local envelope master key for development and tests only
KYC_WEBHOOK_SECRET=CHANGE_ME                 # HMAC-SHA256 secret for identity provider verdicts
KYC_DOCUMENT_BUCKET=                         # private S3 bucket; empty = memory store outside production
AWS_REGION=ap-east-1
FIELD_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES  # AES-256-GCM for TOTP secrets and OTP delivery payloads

# ---- Feature gates (real-money features stay OFF until approvals are confirmed) ----
FEATURE_LIVE_PAYMENTS=false
FEATURE_LIVE_TRANSFERS=false
FEATURE_LIVE_TRADING=false
FEATURE_LIVE_KYC_PROVIDER=false

# ---- Payment providers (sandbox credentials only, from provider dashboards) --
# PAYMENT_ENVIRONMENT=sandbox until a provider is approved. Live also needs FEATURE_LIVE_PAYMENTS and a ProviderApproval row.
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_RETURN_URL=https://app.hkfinhub.example/payments/return
RAZORPAYX_ACCOUNT_NUMBER=
ADYEN_HMAC_KEY=
ADYEN_MERCHANT_ACCOUNT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_HMAC_KEY=
ADYEN_MERCHANT_ACCOUNT=

# ---- Brokers ----------------------------------------------------------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
DRIVEWEALTH_API_KEY=
DRIVEWEALTH_API_SECRET=

# ---- FX rates (provider chosen during Phase 6) -----------------------------
FX_PROVIDER=none
FX_PROVIDER_API_KEY=

# ---- Notifications ----------------------------------------------------------
EMAIL_PROVIDER=none
SMS_PROVIDER=none
PUSH_PROVIDER=none                  # Expo push or FCM/APNs
SENTRY_DSN=

# ---- Object storage (private bucket, encrypted, no public ACLs) ------------
S3_BUCKET_KYC_DOCUMENTS=                  # superseded by KYC_DOCUMENT_BUCKET; kept for infrastructure templates

# ---- Operator login (the only login; customers cannot sign up) -------------
# Set all three together. The password is read from the environment and is never stored in the repository.
LOGIN_USER_EMAIL=
LOGIN_USER_PHONE=
LOGIN_USER_PASSWORD=
LOGIN_USER_NAME=Operator
