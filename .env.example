# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Use the POOLED connection string in serverless (e.g. Neon "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pubgstore?schema=public&sslmode=require"
# Optional: max connections per server instance (keep small on serverless)
DB_POOL_MAX=5

# ── App ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PUBG Store"

# ── Razorpay (server-only secrets — never prefix with NEXT_PUBLIC_) ─────
# Leave empty in development to disable online payments (wallet checkout still works).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Media storage ──────────────────────────────────────────────────────
# "local" (development only, writes to public/uploads) or "cloudinary" (production)
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Scheduled maintenance (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ──
CRON_SECRET="generate-a-long-random-string"

# ── Tests only ─────────────────────────────────────────────────────────
# Disposable database for `npm run test:integration` (it is wiped and re-seeded).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pubgstore_test?schema=public"
