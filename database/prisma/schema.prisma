// HK FinHub database schema, phase 4: identity, sessions, verification, outbox and audit.
// Money tables (ledger, accounts, transfers) arrive in phase 5.
// Secrets are never stored in plain text: passwords are Argon2id hashes, OTPs and refresh
// tokens are keyed HMAC digests, TOTP secrets are AES-256-GCM envelopes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  PASSWORD_RESET
}

model User {
  id               String     @id @default(uuid(7))
  customerNumber   String     @unique
  email            String     @unique
  phoneE164        String     @unique
  passwordHash     String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  passwordChangedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  profile          UserProfile?
  devices          Device[]
  sessions         Session[]
  otpChallenges    OtpChallenge[]
  totpFactor       TotpFactor?
  recoveryCodes    RecoveryCode[]
  mfaChallenges    MfaChallenge[]
  notifications    Notification[]
  account          Account?
}

model UserProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  countryCode  String   @db.VarChar(2)
  language     String   @db.VarChar(16)
  baseCurrency String   @default("HKD") @db.VarChar(3)
  timezone     String   @default("Asia/Hong_Kong")
  updatedAt    DateTime @updatedAt
}

model Device {
  id         String    @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String    @db.VarChar(16)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  sessions   Session[]

  @@index([userId])
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(64)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([deviceId])
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([sessionId])
}

model OtpChallenge {
  id          String     @id @default(uuid(7))
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     OtpChannel
  purpose     OtpPurpose
  destination String
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, purpose])
}

model TotpFactor {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc   String
  confirmedAt DateTime?
  lastUsedStep BigInt?
  createdAt   DateTime  @default(now())
}

model RecoveryCode {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?

  @@index([userId])
}

// Short-lived token issued after a correct password when 2FA is enabled.
model MfaChallenge {
  id         String    @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Transactional outbox: written in the same transaction as the state change, relayed to the queue.
model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String    @db.VarChar(64)
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model Notification {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String    @db.VarChar(16)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(500)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid(7))
  actorUserId String?
  action      String   @db.VarChar(64)
  subjectType String   @db.VarChar(32)
  subjectId   String?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 5: accounts and the double-entry ledger.
// Entries and transactions are immutable (database triggers). Balances change only through
// the posting function, which sets a transaction-local write flag. Each transaction's entries
// must balance per currency at commit (deferred trigger). Customer balances cannot go negative.
// ---------------------------------------------------------------------------

enum LedgerOwnerType {
  CUSTOMER
  PLATFORM
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum LedgerTxKind {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_HOLD
  TRANSFER_SETTLE
  TRANSFER_RELEASE
  FX_CONVERSION
  FEE
  REVERSAL
  ADJUSTMENT
  TRADE_SETTLEMENT
  INTERNAL_TRANSFER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Currency {
  code              String  @id @db.VarChar(3)
  name              String  @db.VarChar(64)
  symbol            String  @db.VarChar(8)
  minorUnitExponent Int
  isEnabled         Boolean @default(true)
}

model Account {
  id          String         @id @default(uuid(7))
  userId      String         @unique
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountRef  String         @unique @db.VarChar(16)
  status      String         @default("ACTIVE") @db.VarChar(16)
  createdAt   DateTime       @default(now())
  currencyAccounts CurrencyAccount[]
  beneficiaries    Beneficiary[]
}

model CurrencyAccount {
  id                String   @id @default(uuid(7))
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency          String   @db.VarChar(3)
  availableLedgerId String   @unique
  holdLedgerId      String   @unique
  createdAt         DateTime @default(now())

  @@unique([accountId, currency])
}

model Beneficiary {
  id             String    @id @default(uuid(7))
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String    @db.VarChar(120)
  country        String    @db.VarChar(2)
  method         String    @db.VarChar(8)
  currency       String    @db.VarChar(3)
  destinationEnc String
  destinationMasked String @db.VarChar(64)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([accountId])
}

model LedgerAccount {
  id            String         @id @default(uuid(7))
  ownerType     LedgerOwnerType
  ownerId       String         @db.VarChar(64)
  currency      String         @db.VarChar(3)
  purpose       String         @db.VarChar(32)
  normalSide    LedgerSide
  allowNegative Boolean        @default(false)
  createdAt     DateTime       @default(now())
  balance       LedgerBalance?
  entries       LedgerEntry[]

  @@unique([ownerType, ownerId, currency, purpose])
}

model LedgerBalance {
  ledgerAccountId String   @id
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])
  balanceMinor    BigInt
  updatedAt       DateTime @default(now())
}

model LedgerTransaction {
  id              String        @id @default(uuid(7))
  kind            LedgerTxKind
  idempotencyKey  String        @unique @db.VarChar(128)
  requestHash     String        @db.VarChar(64)
  description     String        @db.VarChar(200)
  reference       String?       @db.VarChar(128)
  reversesId      String?       @unique
  createdBy       String?       @db.VarChar(64)
  postedAt        DateTime      @default(now())
  entries         LedgerEntry[]
}

model LedgerEntry {
  id              String            @id @default(uuid(7))
  transactionId   String
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id])
  ledgerAccountId String
  ledgerAccount   LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])
  side            LedgerSide
  amountMinor     BigInt
  currency        String            @db.VarChar(3)
  createdAt       DateTime          @default(now())

  @@index([transactionId])
  @@index([ledgerAccountId, createdAt])
}

model ReconciliationRecord {
  id              String    @id @default(uuid(7))
  runAt           DateTime  @default(now())
  ledgerAccountId String
  expectedMinor   BigInt
  recordedMinor   BigInt
  status          String    @db.VarChar(16)
  resolvedAt      DateTime?

  @@index([status, runAt])
}

// Maker-checker: a sensitive financial change is requested by one person and posted only when a
// different person approves it. Admin roles arrive in phase 9; the check is enforced here already.
model ApprovalRequest {
  id           String         @id @default(uuid(7))
  action       String         @db.VarChar(32)
  payload      Json
  requestedBy  String         @db.VarChar(64)
  status       ApprovalStatus @default(PENDING)
  decidedBy    String?        @db.VarChar(64)
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Phase 6: payment providers, FX, transfers and payment requests.
// Live routes are disabled by default. Live money also needs a ProviderApproval row.
// ---------------------------------------------------------------------------

enum PaymentDirection {
  COLLECTION
  PAYOUT
}

enum PaymentStatusDb {
  CREATED
  PENDING
  SUBMITTED
  SUCCEEDED
  FAILED
  REFUNDED
}

model ProviderCapability {
  id          String  @id @default(uuid(7))
  providerId  String  @db.VarChar(32)
  environment String  @db.VarChar(8)
  direction   PaymentDirection
  country     String  @db.VarChar(2)
  currency    String  @db.VarChar(3)
  method      String  @db.VarChar(8)
  enabled     Boolean @default(false)

  @@unique([providerId, environment, direction, country, currency, method])
}

model ProviderApproval {
  id          String   @id @default(uuid(7))
  providerId  String   @db.VarChar(32)
  environment String   @db.VarChar(8)
  contractRef String   @db.VarChar(64)
  approvedBy  String   @db.VarChar(64)
  approvedAt  DateTime @default(now())

  @@unique([providerId, environment])
}

model Payment {
  id                  String           @id @default(uuid(7))
  direction           PaymentDirection
  providerId          String           @db.VarChar(32)
  environment         String           @db.VarChar(8)
  providerRef         String?          @db.VarChar(128)
  reference           String           @unique @db.VarChar(64)
  idempotencyKey      String           @unique @db.VarChar(128)
  accountId           String
  currency            String           @db.VarChar(3)
  amountMinor         BigInt
  method              String           @db.VarChar(8)
  country             String           @db.VarChar(2)
  status              PaymentStatusDb
  transferId          String?          @unique
  metadata            Json
  ledgerTransactionId String?
  failureReason       String?          @db.VarChar(200)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([providerId, providerRef])
  @@index([accountId, createdAt])
}

model ProviderWebhook {
  id          String    @id @default(uuid(7))
  providerId  String    @db.VarChar(32)
  eventId     String    @db.VarChar(160)
  type        String    @db.VarChar(64)
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?   @db.VarChar(32)

  @@unique([providerId, eventId])
}

model FxQuote {
  id                  String    @id @default(uuid(7))
  accountId           String
  fromCurrency        String    @db.VarChar(3)
  toCurrency          String    @db.VarChar(3)
  amountMinor         BigInt
  feeMinor            BigInt
  recipientMinor      BigInt
  rateScaled          BigInt
  provider            String    @db.VarChar(32)
  quotedAt            DateTime
  expiresAt           DateTime
  executedAt          DateTime?
  ledgerTransactionId String?

  @@index([accountId, quotedAt])
}

model Transfer {
  id                  String    @id @default(uuid(7))
  accountId           String
  kind                String    @db.VarChar(16)
  status              String    @db.VarChar(16)
  sourceCurrency      String    @db.VarChar(3)
  sourceMinor         BigInt
  feeMinor            BigInt
  recipientCurrency   String    @db.VarChar(3)
  recipientMinor      BigInt
  fxQuoteId           String?
  recipientAccountId  String?
  destinationMasked   String?   @db.VarChar(64)
  method              String?   @db.VarChar(8)
  country             String?   @db.VarChar(2)
  paymentId           String?   @unique
  ledgerTransactionId String?
  failureReason       String?   @db.VarChar(200)
  idempotencyKey      String    @unique @db.VarChar(128)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([accountId, createdAt])
  @@index([accountId, sourceCurrency, status])
}

model PaymentRequest {
  ref         String    @id @db.VarChar(16)
  accountId   String
  currency    String    @db.VarChar(3)
  amountMinor BigInt?
  memo        String    @db.VarChar(80)
  status      String    @db.VarChar(16)
  paymentId   String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 7: KYC, compliance cases, screening and limits.
// Identity numbers are envelope-encrypted; documents are encrypted before storage and only their
// metadata lives here. Every read of an identity document is audited (see the KYC service).
// ---------------------------------------------------------------------------

model KycRecord {
  id              String    @id @default(uuid(7))
  userId          String    @unique
  status          String    @db.VarChar(32)
  tier            String    @db.VarChar(16)
  providerRef     String?   @db.VarChar(128)
  rejectionReason String?   @db.VarChar(200)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  files           KycFile[]
}

model KycIdentity {
  userId            String   @id
  panEnc            String?
  panMasked         String?  @db.VarChar(16)
  passportEnc       String?
  passportMasked    String?  @db.VarChar(16)
  dateOfBirthEnc    String?
  nationality       String?  @db.VarChar(2)
  updatedAt         DateTime @updatedAt
}

model KycFile {
  id              String    @id @default(uuid(7))
  kycRecordId     String
  kycRecord       KycRecord @relation(fields: [kycRecordId], references: [id], onDelete: Cascade)
  kind            String    @db.VarChar(24)
  storageKey      String    @unique @db.VarChar(160)
  checksumSha256  String    @db.VarChar(64)
  sizeBytes       Int
  mimeType        String    @db.VarChar(64)
  wrappedKey      String
  scanStatus      String    @db.VarChar(16)
  createdAt       DateTime  @default(now())

  @@index([kycRecordId])
}

model ComplianceCase {
  id              String    @id @default(uuid(7))
  kind            String    @db.VarChar(32)
  status          String    @db.VarChar(16)
  severity        String    @db.VarChar(8)
  blocking        Boolean
  subjectType     String    @db.VarChar(16)
  subjectId       String
  accountId       String?
  detail          Json
  openedAt        DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?   @db.VarChar(64)
  resolutionNote  String?   @db.VarChar(500)

  @@index([subjectType, subjectId, status])
  @@index([accountId, status])
}

model ScreeningResult {
  id          String   @id @default(uuid(7))
  subjectType String   @db.VarChar(16)
  subjectId   String
  provider    String   @db.VarChar(32)
  hitCount    Int
  detail      Json
  screenedAt  DateTime @default(now())

  @@index([subjectType, subjectId])
}

model LimitRule {
  id          String   @id @default(uuid(7))
  tier        String   @db.VarChar(16)
  corridor    String   @db.VarChar(4)
  scope       String   @db.VarChar(16)
  currency    String   @db.VarChar(3)
  amountMinor BigInt
  updatedAt   DateTime @updatedAt

  @@unique([tier, corridor, scope, currency])
}

// ---------------------------------------------------------------------------
// Phase 9: staff access. A staff member is also a User, who must have TOTP confirmed.
// Roles are enforced on the server for every admin endpoint.
// ---------------------------------------------------------------------------

model StaffMember {
  userId     String   @id
  role       String   @db.VarChar(24)
  status     String   @db.VarChar(16)
  createdBy  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 8: investment orders and broker fills. Holdings are computed from fills only.
// A broker fill id is unique, so a fill cannot be recorded twice.
// ---------------------------------------------------------------------------

model InvestmentOrder {
  id              String           @id @default(uuid(7))
  userId          String
  accountId       String
  symbol          String           @db.VarChar(12)
  side            String           @db.VarChar(4)
  quantity        BigInt
  limitPriceMinor BigInt?
  currency        String           @db.VarChar(3)
  status          String           @db.VarChar(20)
  brokerOrderId   String           @db.VarChar(64)
  brokerId        String           @db.VarChar(32)
  filledQuantity  BigInt           @default(0)
  settledMinor    BigInt?
  settlementTxId  String?
  idempotencyKey  String           @db.VarChar(128)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fills           InvestmentFill[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([accountId, status])
}

model InvestmentFill {
  id           String          @id @default(uuid(7))
  orderId      String
  order        InvestmentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  brokerFillId String          @unique @db.VarChar(128)
  side         String          @db.VarChar(4)
  quantity     BigInt
  priceMinor   BigInt
  executedAt   DateTime

  @@index([orderId])
}
