// HK FinHub database schema, phase 4: identity, sessions, verification, outbox and audit.
// Money tables (ledger, accounts, transfers) arrive in phase 5.
// Secrets are never stored in plain text: passwords are Argon2id hashes, OTPs and refresh
// tokens are keyed HMAC digests, TOTP secrets are AES-256-GCM envelopes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
  CLOSED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  PASSWORD_RESET
}

model User {
  id               String     @id @default(uuid(7))
  customerNumber   String     @unique
  email            String     @unique
  phoneE164        String     @unique
  passwordHash     String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  passwordChangedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  profile          UserProfile?
  devices          Device[]
  sessions         Session[]
  otpChallenges    OtpChallenge[]
  totpFactor       TotpFactor?
  recoveryCodes    RecoveryCode[]
  mfaChallenges    MfaChallenge[]
  notifications    Notification[]
}

model UserProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  countryCode  String   @db.VarChar(2)
  language     String   @db.VarChar(16)
  baseCurrency String   @default("HKD") @db.VarChar(3)
  timezone     String   @default("Asia/Hong_Kong")
  updatedAt    DateTime @updatedAt
}

model Device {
  id         String    @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String    @db.VarChar(16)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  sessions   Session[]

  @@index([userId])
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(64)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([deviceId])
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([sessionId])
}

model OtpChallenge {
  id          String     @id @default(uuid(7))
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     OtpChannel
  purpose     OtpPurpose
  destination String
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, purpose])
}

model TotpFactor {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc   String
  confirmedAt DateTime?
  lastUsedStep BigInt?
  createdAt   DateTime  @default(now())
}

model RecoveryCode {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?

  @@index([userId])
}

// Short-lived token issued after a correct password when 2FA is enabled.
model MfaChallenge {
  id         String    @id @default(uuid(7))
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Transactional outbox: written in the same transaction as the state change, relayed to the queue.
model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String    @db.VarChar(64)
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}

model Notification {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String    @db.VarChar(16)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(500)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid(7))
  actorUserId String?
  action      String   @db.VarChar(64)
  subjectType String   @db.VarChar(32)
  subjectId   String?
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
